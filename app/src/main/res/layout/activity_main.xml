<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:paddingBottom="12dp" />

        <!-- کادر خواندن متن -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout style="@style/CardBody">
                <TextView style="@style/CardTitle" android:text="خواندن متن" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="13sp" android:paddingBottom="6dp"
                    android:text="متن را اینجا بچسبانید یا تایپ کنید و دکمه بخوان را بزنید." />
                <EditText android:id="@+id/etTest"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minLines="4" android:maxLines="12" android:gravity="top|start"
                    android:hint="متن برای خواندن"
                    android:inputType="textMultiLine" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="6dp">
                    <Button android:id="@+id/btnSpeak"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="بخوان" />
                    <Button android:id="@+id/btnPause"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:layout_height="wrap_content" android:text="مکث / ادامه" />
                    <Button android:id="@+id/btnStop"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:layout_height="wrap_content" android:text="توقف" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btnPaste"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="چسباندن و خواندن" />
                    <Button android:id="@+id/btnClear"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="پاک کردن" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ۱. سرویس -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout style="@style/CardBody">
                <TextView style="@style/CardTitle" android:text="۱. فعال‌سازی سرویس" />
                <TextView android:id="@+id/tvService"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="15sp" android:paddingBottom="8dp" />
                <Button android:id="@+id/btnAccessibility"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="باز کردن تنظیمات دسترسی‌پذیری" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="13sp" android:paddingTop="8dp"
                    android:text="اگر سرویس خاکستری بود و پیام «تنظیمات محدودشده» آمد: دکمه زیر را بزنید، از منوی ⋮ بالای صفحه گزینه «Allow restricted settings» را بزنید و دوباره سرویس را روشن کنید." />
                <Button android:id="@+id/btnAppInfo"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="اطلاعات برنامه (مجوز تنظیمات محدودشده)" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ۲. صدا -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout style="@style/CardBody">
                <TextView style="@style/CardTitle" android:text="۲. موتور صدا" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="موتور فارسی:" android:textSize="14sp" />
                <Spinner android:id="@+id/spEngine"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvLang"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="14sp" android:paddingTop="6dp" android:paddingBottom="6dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="موتور انگلیسی (برای جمله‌های انگلیسی):" android:textSize="14sp"
                    android:paddingTop="4dp" />
                <Spinner android:id="@+id/spEngineEn"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingBottom="6dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btnTtsSettings"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="تنظیمات TTS" />
                    <Button android:id="@+id/btnInstallVoice"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_height="wrap_content" android:text="نصب داده صدا" />
                </LinearLayout>
                <TextView android:id="@+id/tvRate"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingTop="10dp" />
                <SeekBar android:id="@+id/sbRate"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:max="30" />
                <TextView android:id="@+id/tvPitch"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingTop="6dp" />
                <SeekBar android:id="@+id/sbPitch"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:max="30" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ۲.۵ صدای ابری -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout style="@style/CardBody">
                <TextView style="@style/CardTitle" android:text="صدای ابری (Gemini TTS)" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swCloud"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="استفاده از صدای ابری به‌جای موتور گوشی" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="13sp" android:paddingTop="4dp" android:paddingBottom="6dp"
                    android:text="کیفیت خیلی طبیعی‌تر، ولی نیاز به اینترنت و کلید API از aistudio.google.com دارد و متن صفحه برای خوانده‌شدن به سرور گوگل فرستاده می‌شود." />
                <EditText android:id="@+id/etApiKey"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="کلید API" android:inputType="textPassword"
                    android:layoutDirection="ltr" android:textDirection="ltr" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="صدا:" android:textSize="14sp" android:paddingTop="6dp" />
                <Spinner android:id="@+id/spVoice"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etModel"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="نام مدل" android:inputType="text"
                    android:layoutDirection="ltr" android:textDirection="ltr" />
                <EditText android:id="@+id/etStyle"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="لحن خواندن (اختیاری)" android:inputType="textMultiLine" />
                <Button android:id="@+id/btnTestCloud"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="آزمایش اتصال ابری" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ۳. OCR -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout style="@style/CardBody">
                <TextView style="@style/CardTitle" android:text="۳. زبان تشخیص متن از تصویر (🔍)" />
                <RadioGroup android:id="@+id/rgOcr"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RadioButton android:id="@+id/rbFas"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="فقط فارسی (سریع‌تر)" />
                    <RadioButton android:id="@+id/rbFasEng"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="فارسی + انگلیسی" />
                    <RadioButton android:id="@+id/rbEng"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="فقط انگلیسی" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ۴. گزینه‌ها -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout style="@style/CardBody">
                <TextView style="@style/CardTitle" android:text="۴. گزینه‌ها" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swPanel"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="نمایش دکمه شناور" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swContinuous"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="خواندن پیوسته (اسکرول خودکار تا انتهای صفحه/کتاب)" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swSkipButtons"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="نخواندن دکمه‌ها و آیکون‌ها" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swAutoLang"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="جمله‌های انگلیسی با صدای انگلیسی" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:paddingTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="راهنمای دکمه شناور:\n🔊 باز/بسته کردن منو (با کشیدن جابه‌جا می‌شود)\n📖 خواندن متن صفحه (وب، پیام‌رسان، اخبار، PDF)\n🔍 تشخیص متن از تصویر صفحه (PDF اسکن‌شده، عکس، کتاب تصویری)\n⏸ مکث / ادامه     ⏪ ⏩ جمله قبل / بعد\n⏭ صفحه بعد     ⏹ توقف\n📋 خواندن متن کپی‌شده\n\nخواندن متن انتخاب‌شده: در هر اپی متن را انتخاب کنید، در منوی ظاهرشده (در صورت نیاز از ⋮) گزینه «بلند بخوان» را بزنید.\n\nخواندن متن کپی‌شده: دکمه 📋 روی منوی شناور، یا کادر «خواندن متن» در همین صفحه." />
    </LinearLayout>
</ScrollView>
